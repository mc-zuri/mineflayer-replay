{
  "name": "mineflayer-replay",
  "version": "0.0.0",
  "private": true,
  "description": "Replays recorded vanilla Java client sessions through prismarine-physics and a whole mineflayer bot, tick by tick, to find divergences from vanilla",
  "main": "index.js",
  "scripts": {
    "test": "mocha --reporter dot --exit \"test/unit/*.test.js\"",
    "test:engine": "mocha --reporter dot --exit test/replay/engine.test.js",
    "test:bot": "mocha --reporter dot --exit test/replay/bot.test.js",
    "baseline": "node tools/baseline.js",
    "fixtures": "node tools/fixtures.js",
    "lint": "standard"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "peerDependencies": {
    "mineflayer": "*"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "minecraft-protocol": "^1.68.0",
    "prismarine-block": "^1.23.0",
    "prismarine-chunk": "^1.41.0",
    "prismarine-physics": "^1.11.1",
    "prismarine-registry": "^1.12.0",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "mineflayer": "github:mc-zuri/mineflayer#feat/physics-manual",
    "mocha": "^11.0.1",
    "standard": "^17.0.0"
  }
}
